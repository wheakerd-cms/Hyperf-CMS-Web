        }
    },
    "publishConfig": {
        "exports": {
            ".": {
                "default": "./dist/index.mjs"
            }
        }
    },
    "dependencies": {
        "@vben-core/composables": "workspace:*",
        "@vben-core/shadcn-ui": "workspace:*",
        "@vben-core/shared": "workspace:*",
        "@vben-core/typings": "workspace:*",
        "@vee-validate/zod": "^4.15.0",
        "@vueuse/core": "^12.8.2",
        "vee-validate": "^4.15.0",
        "vue": "^3.5.13",
        "zod": "^3.24.2",
        "zod-defaults": "^0.1.3"
    }
}
